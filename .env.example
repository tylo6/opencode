# ══ Opencode — Configuration ══
# Copier ce fichier en .env et renseigner les clés personnelles

# ── Anthropic (Claude) ──────────────────
ANTHROPIC_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Azure OpenAI (optionnel) ────────────
AZURE_KEY=
AZURE_ENDPOINT=https://xxx.openai.azure.com/
AZURE_DEPLOY=gpt-4o

# ── OpenAI direct (optionnel) ───────────
OPENAI_KEY=
OPENAI_MODEL=gpt-4o

# ── LM Studio (inférence locale) ────────
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=

# ── Serveur ─────────────────────────────
PORT=3000
